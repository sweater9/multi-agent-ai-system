# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Configuration (optional — enables Push to GitHub in the web UI)
# Create a classic PAT with "repo" scope. Never commit the real token.
# On Render: set these in the service Environment tab.
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_USERNAME=your_github_username
GITHUB_EMAIL=your_github_email@example.com

# Server Configuration
PORT=5000
DEBUG=False

# Project Configuration
DEFAULT_PROJECT_NAME=multi_agent_project
